# 복사해서 .env 로. 값은 팀 비밀 저장소에서.
APP_ENV=local
DOMAIN_ROOT=example.com
API_URL=http://localhost:8080
APP_URL=http://localhost:3000

POSTGRES_DB=market
POSTGRES_USER=market
POSTGRES_PASSWORD=market

REDIS_URL=redis://redis:6379

# STORAGE_ROOT=                  # 업로드 파일 루트. 빈 값으로 두지 말 것 — 주석이면 bootRun 은 backend/data/uploads, Compose 는 /data/uploads(volume)

JWT_SECRET=
PII_ENCRYPTION_KEY=              # 이름·휴대폰·CI 컬럼 암호화. 32바이트 base64. 한 번 정하면 바꿀 수 없음(재암호화 필요)
ADMIN_LOGIN_ID=                  # 첫 관리자. admin 이 없을 때만 앱 시작 시 생성
ADMIN_PASSWORD=
JWT_ACCESS_TTL_MIN=15
# IDENTITY_VERIFICATION_PROVIDER=stub   # 로컬 개발에서만 주석 해제. 비우면 pass(stub 거부). APP_ENV=local 이 아니면 stub 은 기동 실패
TERMS_VERSION=2026-09-22-draft      # 약관 시행일. 법무 검토 후 확정
JWT_REFRESH_TTL_DAYS=30
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
NTS_API_KEY=                     # 국세청 사업자등록 진위확인 (공공데이터포털)

# 개발 서버를 localhost 말고 다른 주소(VM 의 사설 IP 등)로도 쓸 때만 (http 로 쓰는 로컬 개발 전용). 실제 주소는 .env 에만 — 커밋 금지.
# APP_URL 은 프론트 포트와 맞춘다 (프론트를 -p <포트> 로 띄우면 http://localhost:<포트>)
# ALLOWED_ORIGINS=               # 쉼표 목록. APP_URL 말고 더 허용할 프론트 출처 (예: http://<VM 주소>:<프론트 포트>)
# COOKIE_SECURE=true             # false 는 APP_ENV=local 에서만 (http 접속은 Secure 쿠키를 저장하지 않는다). 운영에서 false 면 기동 실패

# 아래는 frontend/.env.local 에 둔다 (Next 는 루트 .env 를 읽지 않음). 다른 주소로도 쓸 때만 — 이 파일 아래쪽의 NEXT_PUBLIC_API_URL=http://localhost:8080 줄 대신 쓴다(둘 다 두면 나중 줄이 이긴다):
# NEXT_PUBLIC_API_URL=same-origin   # 접속한 주소의 /api 로 부르고 개발 서버가 백엔드로 넘긴다 → localhost·다른 주소 모두 같은 설정
# DEV_ALLOWED_ORIGINS=              # 쉼표 목록, 호스트 이름만(포트 없이). Next 16 개발 서버는 localhost 밖에서 오는 JS 요청을 막는다
# API_PROXY_TARGET=http://localhost:8080   # same-origin 일 때 넘겨 줄 백엔드 (기본값)

# NEXT_PUBLIC_ 은 브라우저에 노출됨. 비밀값 금지
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
