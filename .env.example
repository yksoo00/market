# 복사해서 .env 로. 값은 팀 비밀 저장소에서.
APP_ENV=local
DOMAIN_ROOT=example.com
API_URL=http://localhost:8080
APP_URL=http://localhost:3000

POSTGRES_DB=market
POSTGRES_USER=market
POSTGRES_PASSWORD=

REDIS_URL=redis://redis:6379

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=market

JWT_SECRET=
PII_ENCRYPTION_KEY=              # 이름·휴대폰·CI 컬럼 암호화. 32바이트 base64. 한 번 정하면 바꿀 수 없음(재암호화 필요)
ADMIN_LOGIN_ID=                  # 첫 관리자. admin 이 없을 때만 앱 시작 시 생성
ADMIN_PASSWORD=
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
NTS_API_KEY=                     # 국세청 사업자등록 진위확인 (공공데이터포털)
INTERNAL_TOKEN=                  # spring ↔ ai 내부 호출 확인. 양쪽 동일

AI_URL=http://ai:8000
LLM_API_KEY=                     # ai 서비스만 사용
OCR_API_KEY=
EMBEDDING_MODEL=

# NEXT_PUBLIC_ 은 브라우저에 노출됨. 비밀값 금지
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
