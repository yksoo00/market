# 인증서는 caddy가 Let's Encrypt로 자동 발급. 공유기 80/443 포워딩이 먼저 되어 있어야 함.
api.{$DOMAIN_ROOT} {
    encode gzip

    @internal path /internal/*      # spring ↔ ai 내부 전용. 외부 차단
    respond @internal 404

    # 헬스체크 실패한 인스턴스는 자동 제외 → 배포 중에도 끊김 없음
    reverse_proxy api-1:8080 api-2:8080 {
        lb_policy round_robin
        health_uri /actuator/health
        health_interval 5s
        health_timeout 3s
        fail_duration 10s
    }

    log {
        output stdout
        format json
    }
}
